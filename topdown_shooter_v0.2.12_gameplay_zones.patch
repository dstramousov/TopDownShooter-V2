+        points: list[TileCoord] = []
+        for item in value:
+            if not isinstance(item, dict):
+                continue
+            position = item.get("position")
+            if position is None:
+                continue
+            points.append(self._parse_tile_coord(position, context="gameplay_zones.point"))
+        return tuple(points)
